{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditEventEnvelope",
  "type": "object",
  "properties": {
    "connectorId": {
      "anyOf": [
        {
          "$ref": "#/$defs/ConnectorId"
        },
        {
          "type": "null"
        }
      ]
    },
    "correlationId": {
      "type": "string",
      "format": "uuid"
    },
    "endpointClass": {
      "type": [
        "string",
        "null"
      ]
    },
    "eventName": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "occurredAt": {
      "$ref": "#/$defs/Timestamp"
    },
    "outcome": {
      "$ref": "#/$defs/AuditOutcome"
    },
    "recordCount": {
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "resultCategory": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    },
    "sourceAccountId": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceAccountId"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "eventName",
    "occurredAt",
    "outcome",
    "correlationId",
    "resultCategory"
  ],
  "$defs": {
    "AuditOutcome": {
      "type": "string",
      "enum": [
        "SUCCEEDED",
        "REJECTED",
        "FAILED_REDACTED"
      ]
    },
    "ConnectorId": {
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "SourceAccountId": {
      "type": "string",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "maxLength": 35,
      "minLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
