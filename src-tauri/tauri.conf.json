{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AssetRail",
  "version": "0.1.1",
  "identifier": "ai.rsitech.assetrail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "label": "main",
        "title": "AssetRail",
        "width": 1440,
        "height": 920,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy"
    },
    "macOS": {
      "bundleVersion": "1",
      "minimumSystemVersion": "13.0"
    }
  }
}
