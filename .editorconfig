root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,json,jsonl,mjs,ts,tsx,yaml,yml}]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4

[src-tauri/gen/schemas/*.json]
insert_final_newline = false

[Makefile]
indent_style = tab
